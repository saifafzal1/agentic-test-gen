{
  "key": "todomvc",
  "base_url": "https://todomvc.com",
  "auth": null,
  "pages": [
    {
      "path": "/examples/react/dist/",
      "feature": "todo list add/complete/delete",
      "category": "crud_operations",
      "url": "https://todomvc.com/examples/react/dist/",
      "dom": {
        "title": "TodoMVC: React",
        "headings": [
          "React",
          "todos"
        ],
        "inputs": [
          {
            "tag": "input",
            "data-testid": "text-input",
            "type": "text",
            "placeholder": "What needs to be done?",
            "aria-label": "New Todo Input",
            "class": "new-todo"
          },
          {
            "tag": "input",
            "id": "toggle-all",
            "data-testid": "toggle-all",
            "type": "checkbox",
            "class": "toggle-all"
          }
        ],
        "buttons": [
          {
            "tag": "button",
            "class": "clear-completed",
            "text": "Clear completed"
          }
        ],
        "links": [
          {
            "tag": "a",
            "href": "https://github.com/tastejs/todomvc/tree/gh-pages/examples/react",
            "text": "Source"
          },
          {
            "tag": "a",
            "href": "https://todomvc.com/examples/typescript-react",
            "class": "demo-link",
            "text": "Demo"
          },
          {
            "tag": "a",
            "href": "https://github.com/tastejs/todomvc/tree/gh-pages/examples/typescript-react",
            "text": "Source"
          },
          {
            "tag": "a",
            "href": "http://facebook.github.io/react",
            "text": "React"
          },
          {
            "tag": "a",
            "href": "https://react.dev/learn",
            "text": "Quick Start"
          },
          {
            "tag": "a",
