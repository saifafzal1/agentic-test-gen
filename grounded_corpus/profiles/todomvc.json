          },
          {
            "tag": "a",
            "href": "#/",
            "class": "selected",
            "text": "All"
          },
          {
            "tag": "a",
            "href": "#/active",
            "text": "Active"
          },
          {
            "tag": "a",
            "href": "#/completed",
            "text": "Completed"
          },
          {
            "tag": "a",
            "href": "http://todomvc.com",
            "text": "TodoMVC"
          }
        ],
        "selects": [],
        "data_test_elements": [
          {
            "tag": "header",
            "data-testid": "header",
            "class": "header",
            "text": "todos"
          },
          {
            "tag": "input",
            "data-testid": "text-input",
            "type": "text",
            "placeholder": "What needs to be done?",
            "aria-label": "New Todo Input",
            "class": "new-todo"
          },
          {
            "tag": "main",
            "data-testid": "main",
            "class": "main",
            "text": "Toggle All Input"
          },
          {
            "tag": "input",
            "id": "toggle-all",
            "data-testid": "toggle-all",
            "type": "checkbox",
            "class": "toggle-all"
          },
          {
            "tag": "ul",
            "data-testid": "todo-list",
            "class": "todo-list"
          },
          {
            "tag": "footer",
            "data-testid": "footer",
            "class": "footer",
            "text": "0 items left!AllActiveCompletedClear completed"
