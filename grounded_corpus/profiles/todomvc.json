          {
            "tag": "ul",
            "data-testid": "footer-navigation",
            "class": "filters",
            "text": "AllActiveCompleted"
          }
        ],
        "ids": [
          {
            "tag": "section",
            "id": "root",
            "class": "todoapp",
            "text": "todosToggle All Input0 items left!AllActiveCompletedClear co"
          },
          {
            "tag": "input",
            "id": "toggle-all",
            "data-testid": "toggle-all",
            "type": "checkbox",
            "class": "toggle-all"
          }
        ]
