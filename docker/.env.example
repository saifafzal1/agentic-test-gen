# Copy to docker/.env and fill in. docker compose reads this automatically,
# which is the cross-platform way to pass settings (inline VAR=value before
# the command does NOT work in Windows PowerShell).
HF_TOKEN=hf_your_read_token_here
RUN_MODEL=phi3
RUN_FRAMEWORK=cypress
RUN_DATA=data/execution_validation/grounded_stories.jsonl
RUN_OUT_DIR=results/execution_validation
# CPU/no-GPU host: cap the run to a few stories for a smoke test (leave
# blank on a GPU host to process the whole dataset). Use phi3, not gemma4,
# on CPU — it is smaller and far faster.
RUN_LIMIT=2
EXEC_MODEL=phi3
EXEC_FRAMEWORK=cypress
